// Copy this file to config.h and fill in your values
// config.h is gitignored

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"
#define API_ENDPOINT "https://smartgarden.duckdns.org"  // no trailing slash
#define SLEEP_SECONDS 3600                     // 1 hour between sensor reads
                                                // (WiFi/POST only happens once every 86400/SLEEP_SECONDS wakes — see soil_moisture.ino)
#define RAW_DRY 682                            // ADC value in air (dry calibration, 10-bit)
#define RAW_WET 268                            // ADC value submerged (wet calibration, 10-bit)
